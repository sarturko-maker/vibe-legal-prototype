{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react",
    "outDir": "./dist",
    "downlevelIteration": true
  },
  "include": [
    "src/taskpane/taskpane.tsx",
    "src/components/**/*",
    "src/services/**/*",
    "src/state/**/*",
    "src/types/**/*",
    "src/utils/logger.ts",
    "src/utils/textUtils.ts",
    "src/utils/xmlUtils.ts",
    "src/utils/officeMock.ts",
    "src/prompts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*StressTest*",
    "**/*FormattingTest*",
    "**/*Diagnostic*",
    "src/tests/**/*",
    "src/taskpane/taskpane.legacy.tsx"
  ]
}